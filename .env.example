# ==============================
# XiaoLuo Lab
# ==============================

APP_NAME=xiaoluo-lab
APP_ENV=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./data/xiaoluo.db
DATA_ROOT=./data
MODEL_ROOT=./models
LOG_LEVEL=INFO

# LLM / Provider-neutral default
# openai_compatible 可用于 OpenAI、DeepSeek、Qwen、Kimi、GLM、OpenRouter、LiteLLM、Ollama、vLLM 等兼容服务。
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_CONTEXT_WINDOW=
LLM_MAX_OUTPUT_TOKENS=

# Agent / Token-aware Context
# 字符预算之外还有一层 token 预算：中文 1 字≈1 token、英文 4 字符≈1 token，
# 只按字符卡会让中文上下文悄悄吃满 LLM 输入窗口。设为 0 可退回纯字符口径。
AGENT_CONTEXT_MAX_CHARS=6000
AGENT_CONTEXT_MAX_TOKENS=4000
AGENT_CONTEXT_USER_REQUEST_CHARS=800
AGENT_CONTEXT_DATASET_CHARS=1600
AGENT_CONTEXT_TASK_CHARS=600
AGENT_CONTEXT_PERMISSION_CHARS=400
AGENT_CONTEXT_TOOL_CHARS=1400
AGENT_CONTEXT_HISTORY_CHARS=1000
AGENT_CONTEXT_HISTORY_MESSAGES=6
AGENT_DATASET_CACHE_ENABLED=true
AGENT_DATASET_CACHE_MAX_ITEMS=32

# Agent LLM budget
AGENT_LLM_MAX_CALLS=6
AGENT_LLM_MAX_INPUT_TOKENS=12000
AGENT_LLM_MAX_OUTPUT_TOKENS=6000
AGENT_LLM_MAX_TOTAL_TOKENS=16000

# ==========================================================
# HTTP 边车：跨域 / 压缩 / 限流
# ==========================================================
# 留空 ⇒ 不放开同源策略。开发时前端走 Vite 代理（同源），无需配置；
# 容器/前后端分离部署才需要填前端实际访问地址（逗号分隔，不要写 *）。
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
GZIP_ENABLED=true
GZIP_MINIMUM_SIZE=1024
# 限流只保护「会产生花费 / 占满 CPU」的写接口（对话、报告生成、训练、导入）。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
# 反向代理之后才可置为 true，否则客户端可伪造 IP 绕过限流
RATE_LIMIT_TRUST_X_FORWARDED_FOR=false

# Local Router（本地小模型路由，实验性）
#   off    = 完全关闭（默认，零风险）
#   shadow = 只记录不改变行为
#   guard  = 预留档，尚未启用
LOCAL_ROUTER_MODE=off

# Agent policy
AGENT_ALLOW_MODEL_FALLBACK=false
AGENT_ENABLE_TOOL_RETRIEVAL=true
AGENT_ENABLE_RESULT_COMPRESSION=true
AGENT_ENABLE_PLAN_CACHE=true
