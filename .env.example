# ==============================
# XiaoLuo Lab
# ==============================

APP_NAME=xiaoluo-lab
APP_ENV=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./data/xiaoluo.db
DATA_ROOT=./data
MODEL_ROOT=./models
LOG_LEVEL=INFO

# LLM / Provider-neutral default
# openai_compatible 可用于 OpenAI、DeepSeek、Qwen、Kimi、GLM、OpenRouter、LiteLLM、Ollama、vLLM 等兼容服务。
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_CONTEXT_WINDOW=
LLM_MAX_OUTPUT_TOKENS=

# Agent / Token-aware Context
# 字符预算之外还有一层 token 预算：中文 1 字≈1 token、英文 4 字符≈1 token，
# 只按字符卡会让中文上下文悄悄吃满 LLM 输入窗口。设为 0 可退回纯字符口径。
AGENT_CONTEXT_MAX_CHARS=6000
AGENT_CONTEXT_MAX_TOKENS=4000
AGENT_CONTEXT_USER_REQUEST_CHARS=800
AGENT_CONTEXT_DATASET_CHARS=1600
AGENT_CONTEXT_TASK_CHARS=600
AGENT_CONTEXT_PERMISSION_CHARS=400
AGENT_CONTEXT_TOOL_CHARS=1400
AGENT_CONTEXT_HISTORY_CHARS=1000
AGENT_CONTEXT_HISTORY_MESSAGES=6
AGENT_DATASET_CACHE_ENABLED=true
AGENT_DATASET_CACHE_MAX_ITEMS=32

# Agent LLM budget
AGENT_LLM_MAX_CALLS=6
AGENT_LLM_MAX_INPUT_TOKENS=12000
AGENT_LLM_MAX_OUTPUT_TOKENS=6000
AGENT_LLM_MAX_TOTAL_TOKENS=16000

# ==========================================================
# HTTP 边车：跨域 / 压缩 / 限流
# ==========================================================
# 留空 ⇒ 不放开同源策略。开发时前端走 Vite 代理（同源），无需配置；
# 容器/前后端分离部署才需要填前端实际访问地址（逗号分隔，不要写 *）。
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
GZIP_ENABLED=true
GZIP_MINIMUM_SIZE=1024
# 限流只保护「会产生花费 / 占满 CPU」的写接口（对话、报告生成、训练、导入）。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
# 反向代理之后才可置为 true，否则客户端可伪造 IP 绕过限流
RATE_LIMIT_TRUST_X_FORWARDED_FOR=false

# ==========================================================
# Local Router（本地小模型意图路由）
# ==========================================================
#   off    = 完全关闭（默认，零风险）：不加载模型、不写 trace
#   shadow = 只记录不改变行为：把「本地会怎么判」与「线上实际怎么走」并排写 trace
#   active = 本地 Router 正式作为第一层意图路由器参与决策
#   guard  = 历史别名，等同 active（已废弃，请改用 active）
LOCAL_ROUTER_MODE=off

# 门控阈值：本地置信度低于此值即转升级。默认 0.0 = 不门控，与离线评测口径一致。
# 打开门控是行为变更，请先用 scripts/router/analyze_fusion.py 看覆盖率-准确率曲线再定值。
LOCAL_ROUTER_CONFIDENCE_THRESHOLD=0.0

# 词法 L1 产物目录。留空 ⇒ {MODEL_ROOT}/local_router/
LOCAL_ROUTER_MODEL_DIR=

# ----------------------------------------------------------
# Qwen3-0.6B + LoRA 神经路由（可选能力）
# ----------------------------------------------------------
# 启用前提：pip install -e "backend[router]"（torch / transformers / peft）。
# 不安装也不会报错——本地 Router 自动退回词法 L1 + L0 规则，主链路不受任何影响。
# 权重不随仓库分发，请自行放置或用下面的配置项指向本地路径。

# LoRA 适配器目录。相对路径（相对项目根或 backend/）与绝对路径都支持。
# 留空 ⇒ 自动探测 {项目根}/models/qwen3-lora-xiaoluo-router
# 示例（相对）：LOCAL_ROUTER_MODEL_PATH=models/qwen3-lora-xiaoluo-router
# 示例（绝对）：LOCAL_ROUTER_MODEL_PATH=D:/models/qwen3-lora-xiaoluo-router
LOCAL_ROUTER_MODEL_PATH=

# 基座模型：本地目录路径，或 HuggingFace repo id。
# 留空 ⇒ 先探测 {项目根}/models/Qwen3-0.6B，不存在则按 Qwen/Qwen3-0.6B 下载
LOCAL_ROUTER_BASE_MODEL=

# 推理设备：auto（CUDA 可用则用 CUDA）/ cuda / cpu
LOCAL_ROUTER_DEVICE=auto

# 单次推理硬超时（毫秒）。超时一律按「模型不可用」降级 ——
# 这条是「SSE 不会挂死、前端不会永远转圈」的保证，不建议调到 0（=不限时）。
LOCAL_ROUTER_TIMEOUT_MS=800

# 生成 token 上限（Router 只输出一段短 JSON，160 足够）
LOCAL_ROUTER_MAX_NEW_TOKENS=160

# 注入提示词的数据集清单条数上限（防止 prefill 被超长清单拖慢）
LOCAL_ROUTER_MAX_CONTEXT_DATASETS=30

# Agent policy
AGENT_ALLOW_MODEL_FALLBACK=false
AGENT_ENABLE_TOOL_RETRIEVAL=true
AGENT_ENABLE_RESULT_COMPRESSION=true
AGENT_ENABLE_PLAN_CACHE=true
